{
  "name": "envguard",
  "version": "0.2.0",
  "description": "Zero-dependency environment auditor, secret entropy scanner, and automated TypeScript definition generator",
  "keywords": [
    "env",
    "dotenv",
    "environment-variables",
    "security",
    "entropy",
    "secret-detection",
    "typescript",
    "typegen",
    "cli",
    "linter",
    "auditor"
  ],
  "author": "Agnet Software Corp. <https://github.com/AgnetAcount>",
  "license": "MIT",
  "homepage": "https://github.com/AgnetAcount/envguard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AgnetAcount/envguard.git"
  },
  "bugs": {
    "url": "https://github.com/AgnetAcount/envguard/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "envguard": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:runner": "node --test tests/**/*.test.js",
    "prepare": "npm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.13.0",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
